# Copy to .env and fill in. NEVER commit .env.

APP_ENV=local                  # local | cloud  — deployment concern only (e.g. cookie Secure flag).
                                # Does NOT select adapters — see the four settings below (TS-07).
SECRET_KEY=change-me

# --- Adapter selection (TS-07) --- each independently switchable, defaulting
# to today's local behaviour. Flip one at a time as you cut over a service.
RESUME_STORE=local             # local | drive
MAILER=local                   # local | gmail
CALENDAR_STORE=local           # local | google
EMBEDDER=fastembed             # fastembed | openai (openai not implemented)
ANALYZER=local                 # local | llm  (see the LLM analyzer block below)
TOKEN_ENCRYPTION_KEY=          # Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"

DATABASE_URL=postgresql+psycopg://autohire:autohire@db:5432/autohire
REDIS_URL=redis://redis:6379/0

FRONTEND_URL=http://localhost:5173
PUBLIC_APPLY_BASE_URL=http://localhost:5173/apply
VITE_API_URL=http://localhost:8000/api/v1

# --- Google (leave blank while RESUME_STORE/MAILER/CALENDAR_STORE are all local) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Embeddings (scoring vectors only — see EMBEDDER above; separate from
# any LLM feedback narrative adapter) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
# Where the fastembed ONNX model is cached — a named volume in docker-compose.yml,
# so it downloads once instead of on every fresh container (US-18).
EMBEDDING_CACHE_DIR=/models

# --- LLM analyzer (ANALYZER=llm) — TS-15 / ADR-006 ---
# Produces matched/missing skills, the feedback narrative, and the relevance
# score that feeds the hybrid ranking blend. Separate from EMBEDDER, which stays
# fastembed-only (drift.md, TS-07).
#
# The adapter speaks OpenAI-compatible Chat Completions, so any provider that
# exposes that endpoint works and switching is these three lines — no code change.
# Only free tiers are in scope for this project; set a spend limit on any key
# regardless (ADR-003).
#
# Gemini free tier (https://aistudio.google.com/apikey):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemini-flash-latest   # alias, not a pinned version — avoids breaking when Google retires dated model names
#
# Grok / xAI (https://console.x.ai):
#   LLM_BASE_URL=https://api.x.ai/v1
#   LLM_MODEL=grok-4-fast
#
# Local Ollama (no key needed, LLM_API_KEY can be any non-empty string):
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=llama3.1
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Hybrid ranking weight (ADR-006): final = (1-w)*cosine + w*llm.
# 0.0 reproduces US-18's pure-cosine ordering exactly — the escape hatch if the
# model proves unreliable. 1.0 would hand the ranking entirely to the LLM, which
# ADR-006 explicitly rejects; keep this well below 0.5.
LLM_SCORE_WEIGHT=0.3
# Resumes are truncated to this many characters before reaching a prompt — free
# tiers are token-limited and the parser imposes no ceiling of its own.
LLM_MAX_RESUME_CHARS=6000

# --- Local mail (Mailhog) ---
SMTP_HOST=mailhog
SMTP_PORT=1025

# --- Upload limits ---
MAX_RESUME_MB=5

# --- Local resume storage (RESUME_STORE=local) ---
# Docker: /storage (mounted from ./storage by docker-compose.yml). Running
# outside that container (CI, a host .venv) needs a real writable path instead.
LOCAL_STORAGE_ROOT=/storage

# --- Admin (TS-14) ---
# The one Google account allowed to reach /api/v1/admin/*. Leave blank to
# disable the admin dashboard entirely (every request gets 403).
ADMIN_EMAIL=

# --- Scheduling ---
# IANA name. Single app-wide zone (US-24) — every recruiter's availability
# window is wall-clock in this zone, never UTC. Written onto each
# scheduling_preferences row at save time, not read live, so changing this
# later doesn't silently reinterpret already-saved rows.
SCHEDULING_TIMEZONE=Asia/Karachi
