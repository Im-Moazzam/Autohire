# Copy to .env and fill in. NEVER commit .env.

APP_ENV=local                  # local | cloud  — selects adapter implementations
SECRET_KEY=change-me
TOKEN_ENCRYPTION_KEY=          # Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"

DATABASE_URL=postgresql+psycopg://autohire:autohire@db:5432/autohire
REDIS_URL=redis://redis:6379/0

FRONTEND_URL=http://localhost:5173
PUBLIC_APPLY_BASE_URL=http://localhost:5173/apply
VITE_API_URL=http://localhost:8000/api/v1

# --- Google (leave blank while APP_ENV=local) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Embeddings ---
# local:  sentence-transformers/all-MiniLM-L6-v2  -> 384
# cloud:  text-embedding-3-small                  -> 1536
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
# Where the fastembed ONNX model is cached — a named volume in docker-compose.yml,
# so it downloads once instead of on every fresh container (US-18).
EMBEDDING_CACHE_DIR=/models

# --- Optional cloud services ---
# Reserved: no cloud analyzer exists yet (TS-07 may add an optional OpenAI
# embedder) — leave blank while APP_ENV=local.
OPENAI_API_KEY=

# --- Local mail (Mailhog) ---
SMTP_HOST=mailhog
SMTP_PORT=1025

# --- Upload limits ---
MAX_RESUME_MB=5

# --- Local resume storage (APP_ENV=local) ---
# Docker: /storage (mounted from ./storage by docker-compose.yml). Running
# outside that container (CI, a host .venv) needs a real writable path instead.
LOCAL_STORAGE_ROOT=/storage

# --- Scheduling ---
# IANA name. Single app-wide zone (US-24) — every recruiter's availability
# window is wall-clock in this zone, never UTC. Written onto each
# scheduling_preferences row at save time, not read live, so changing this
# later doesn't silently reinterpret already-saved rows.
SCHEDULING_TIMEZONE=Asia/Karachi
