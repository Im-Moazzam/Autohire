# Copy to .env and fill in. NEVER commit .env.

APP_ENV=local                  # local | cloud  — selects adapter implementations
SECRET_KEY=change-me
TOKEN_ENCRYPTION_KEY=          # Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"

DATABASE_URL=postgresql+psycopg://autohire:autohire@db:5432/autohire
REDIS_URL=redis://redis:6379/0

FRONTEND_URL=http://localhost:5173
PUBLIC_APPLY_BASE_URL=http://localhost:5173/apply
VITE_API_URL=http://localhost:8000/api/v1

# --- Google (leave blank while APP_ENV=local) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Embeddings ---
# local:  sentence-transformers/all-MiniLM-L6-v2  -> 384
# cloud:  text-embedding-3-small                  -> 1536
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Optional cloud services ---
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=autohire

# --- Local mail (Mailhog) ---
SMTP_HOST=mailhog
SMTP_PORT=1025

# --- Upload limits ---
MAX_RESUME_MB=5
ALLOWED_RESUME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document
