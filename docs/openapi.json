{
  "openapi": "3.1.0",
  "info": { "title": "AutoHire", "version": "0.1.0" },
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": { "type": "string" },
                  "type": "object",
                  "title": "Response Health Api V1 Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/google/login": {
      "get": {
        "tags": ["auth"],
        "summary": "Google Login",
        "operationId": "google_login_api_v1_auth_google_login_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": { "application/json": { "schema": {} } }
          }
        }
      }
    },
    "/api/v1/auth/google/reconnect": {
      "get": {
        "tags": ["auth"],
        "summary": "Google Reconnect",
        "description": "Restart consent for the logged-in recruiter. Reuses the same state-binding\nCSRF cookie as /google/login; the existing /google/callback + upsert_recruiter\nalready replace the stored tokens and flip account_state back to ACTIVE\n(retaining the existing refresh token if Google omits a new one).",
        "operationId": "google_reconnect_api_v1_auth_google_reconnect_get",
        "parameters": [
          {
            "name": "autohire_session",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [{ "type": "string" }, { "type": "null" }],
              "title": "Autohire Session"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": { "application/json": { "schema": {} } }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/google/callback": {
      "get": {
        "tags": ["auth"],
        "summary": "Google Callback",
        "operationId": "google_callback_api_v1_auth_google_callback_get",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [{ "type": "string" }, { "type": "null" }],
              "title": "Code"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [{ "type": "string" }, { "type": "null" }],
              "title": "State"
            }
          },
          {
            "name": "error",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [{ "type": "string" }, { "type": "null" }],
              "title": "Error"
            }
          },
          {
            "name": "autohire_oauth_state",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [{ "type": "string" }, { "type": "null" }],
              "title": "Autohire Oauth State"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": { "application/json": { "schema": {} } }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": ["auth"],
        "summary": "Get Me",
        "operationId": "get_me_api_v1_auth_me_get",
        "parameters": [
          {
            "name": "autohire_session",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [{ "type": "string" }, { "type": "null" }],
              "title": "Autohire Session"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RecruiterOut" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": ["auth"],
        "summary": "Logout",
        "description": "No get_current_recruiter dependency, deliberately \u2014 logout must be\nidempotent with no session (AC-02), not 401. Safe without CSRF protection\nbecause the session cookie is SameSite=Lax: a cross-site POST doesn't carry\nit, so an attacker can't trigger this against a logged-in victim.",
        "operationId": "logout_api_v1_auth_logout_post",
        "responses": { "204": { "description": "Successful Response" } }
      }
    },
    "/api/v1/recruiters/me": {
      "patch": {
        "tags": ["recruiters"],
        "summary": "Update Me",
        "operationId": "update_me_api_v1_recruiters_me_patch",
        "parameters": [
          {
            "name": "autohire_session",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [{ "type": "string" }, { "type": "null" }],
              "title": "Autohire Session"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RecruiterUpdate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RecruiterOut" }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": { "$ref": "#/components/schemas/ValidationError" },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RecruiterOut": {
        "properties": {
          "id": { "type": "string", "format": "uuid", "title": "Id" },
          "email": { "type": "string", "title": "Email" },
          "name": { "type": "string", "title": "Name" },
          "account_state": { "$ref": "#/components/schemas/RecruiterState" },
          "granted_scopes": {
            "items": { "type": "string" },
            "type": "array",
            "title": "Granted Scopes"
          }
        },
        "type": "object",
        "required": ["id", "email", "name", "account_state", "granted_scopes"],
        "title": "RecruiterOut"
      },
      "RecruiterState": {
        "type": "string",
        "enum": ["ACTIVE", "SUSPENDED", "REAUTH_REQUIRED"],
        "title": "RecruiterState"
      },
      "RecruiterUpdate": {
        "properties": {
          "full_name": { "type": "string", "title": "Full Name" }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["full_name"],
        "title": "RecruiterUpdate"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": { "anyOf": [{ "type": "string" }, { "type": "integer" }] },
            "type": "array",
            "title": "Location"
          },
          "msg": { "type": "string", "title": "Message" },
          "type": { "type": "string", "title": "Error Type" },
          "input": { "title": "Input" },
          "ctx": { "type": "object", "title": "Context" }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
        "title": "ValidationError"
      }
    }
  }
}
