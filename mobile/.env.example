# Your machine's LAN IP, found via `ipconfig` (Windows) — a physical phone
# can't resolve "localhost" to your dev machine. The Docker backend already
# binds 0.0.0.0:8000, so this just needs your machine's IP on the network
# your phone is also connected to.
EXPO_PUBLIC_API_HOST=192.168.1.100
EXPO_PUBLIC_API_PORT=8000

# Only needed for real Google sign-in on a phone: Google rejects a LAN IP
# as an OAuth redirect_uri, so tunnel the backend instead. One-time setup:
#   1. Claim a free static domain at https://dashboard.ngrok.com/domains
#      (a rotating ngrok URL means re-registering the redirect URI in
#      Google Cloud Console every restart — a static domain never changes,
#      so that registration is also one-time).
#   2. Save your authtoken into the config the container actually reads
#      (the image's entrypoint always uses /var/lib/ngrok/ngrok.yml,
#      regardless of `ngrok config add-authtoken`'s own default path):
#        docker run --rm -v ngrok-config:/var/lib/ngrok --entrypoint sh ngrok/ngrok -c \
#          'rm -f /var/lib/ngrok/ngrok.yml && printf "version: 3\nagent:\n    authtoken: %s\n    web_addr: 0.0.0.0:4040\n" "<your-authtoken>" > /var/lib/ngrok/ngrok.yml'
#   3. Register https://<your-domain>/api/v1/auth/google/callback in
#      Google Cloud Console — once, ever.
# Then every time you need the tunnel (from repo root):
#   docker run --network autohire_default -v ngrok-config:/var/lib/ngrok --rm ngrok/ngrok http api:8000 --url=https://<your-domain>
# Overrides EXPO_PUBLIC_API_HOST/PORT above when set.
# EXPO_PUBLIC_API_ORIGIN=https://your-domain.ngrok-free.dev
